CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_WLAN_VENDOR_REALTEK=y

CONFIG_MAC80211=m
CONFIG_MAC80211_HAS_RC=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
CONFIG_MAC80211_RC_DEFAULT="minstrel_ht"
CONFIG_MAC80211_MESH=y
CONFIG_MAC80211_STA_HASH_MAX_SIZE=0

# Оригинальный драйвер MediaTek MT7921U
CONFIG_MT76_CORE=m
CONFIG_MT76_LEDS=y
CONFIG_MT76_USB=m
CONFIG_MT76_CONNAC_LIB=m
CONFIG_MT7921_COMMON=m
CONFIG_MT7921U=m

# Драйвер Ralink RT5370 (TP-Link TL-WN727N v4)
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y

# Дополнительные популярные адаптеры (MediaTek MT7601U, Atheros AR9271, RTL8187)
CONFIG_MT7601U=m
CONFIG_ATH_COMMON=m
CONFIG_ATH9K_HW=m
CONFIG_ATH9K_COMMON=m
CONFIG_ATH9K_HTC=m
CONFIG_RTL8187=m

# Внешний USB Bluetooth-адаптер
CONFIG_BT=y
CONFIG_BT_HCIBTUSB=m

# Возможность подгружать свои .ko модули без проверки подписей
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_FORCE=n
